<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/label_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/overlay_editor_type" />

    <Spinner
        android:id="@+id/type_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/label_mapping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To"
        android:paddingStart="16dp" />

    <Spinner
        android:id="@+id/button_control_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/label_mapping_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doing"
        android:paddingStart="16dp" />

    <Spinner
        android:id="@+id/mapping_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- IR Pointer parameters (shown only when type is IR Pointer to Stick) -->
    <TextView
        android:id="@+id/label_ir_accel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acceleration"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/ir_accel_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/label_ir_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speed"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/ir_speed_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/scope_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_editor_scope_game" />
</LinearLayout>
